'KRAKENC manual shallow-water example'
500                  ! Frequency Hz
1                    ! Number of finite media (excluding halfspaces)
'CVW'                ! C-linear SSP, vacuum top, dB/wavelength
2000 0 200           ! Initial mesh, roughness m, water bottom m
0   1500 0 1.0 0 0 / ! z, cp, cs, density g/cm3, ap, as
200 1500 /
'A' 0                ! Bottom halfspace, zero roughness
200 1600 0 1.8 0.2 0 /
0 20000              ! Phase-speed search bounds m/s
1.5                  ! RMAX km (mode accuracy control)
1                    ! Source depths
25 /
41                   ! Mode output depths, 0:5:200 m
0 200 /
